#!/bin/bash

PROJECT_ROOT="$(dirname "$(dirname "$(realpath "$0")")")"

echo $PROJECT_ROOT

# Argument 1 should always be a command
case "$1" in
	login)
        # Arguemnt 2 should be the user_id from fingerprinting
		"$PROJECT_ROOT/commands/login" $2
		;;
	*)
		echo "Usage: spoticli <command>"
		echo
		echo "Commands:"
		echo "	login		Log in with Spotify"
		;;
esac
