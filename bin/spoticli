#!/bin/bash

PROJECT_ROOT="$(dirname "$(dirname "$(realpath "$0")")")"


# Argument 1 should always be a command
case "$1" in
	login)
        # Arguemnts: <user_fingerprint> user_id<ptr>
		"$PROJECT_ROOT/commands/login.sh" $2 "${@:3}"
		;;
    reauth)
        # Arguemnts: <user_id>
        "$PROJECT_ROOT/commands/reauth.sh" $2 "${@:3}"
        ;;
    streamstate)
        # Arguemnts: <user_id>
        "$PROJECT_ROOT/commands/stream_state.sh" $2 "${@:3}"
        ;;
    search)
        # Arguemnts: <user_id>
        "$PROJECT_ROOT/commands/search.sh" $2 "${@:3}"
        ;;
    library)
        # Arguments: <user_id>
        "$PROJECT_ROOT/commands/library.sh" $2 "${@:3}"
        ;;
    *)
		echo "Usage: spoticli <command>"
		echo
		echo "Commands:"
		echo "	login		Log in with Spotify"
		;;
esac
