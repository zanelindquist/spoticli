#!/bin/bash

PROJECT_ROOT="$(dirname "$(dirname "$(realpath "$0")")")"

# Argument 1 should always be a command
case "$1" in
	login)
        # Arguemnts: <user_fingerprint>
		"$PROJECT_ROOT/commands/login.sh" $2
		;;
    reauth)
        # Arguemnts: <user_id>
        "$PROJECT_ROOT/commands/reauth.sh" $2
        ;;
	*)
		echo "Usage: spoticli <command>"
		echo
		echo "Commands:"
		echo "	login		Log in with Spotify"
		;;
esac
